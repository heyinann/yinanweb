---
interface Props {
	title: string;
}

const { title } = Astro.props;

// Layout.astro
import "../style/global.css";
import { useState } from 'react';

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.gif" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<div class="left-nav">
			  <!-- Home 链接 -->
			  <h1 class="home">
				<a href="/">⌫ home</a>
			  </h1>
			  <!-- Articles 链接 -->
			  <h1 class="article">
				<a href="/articles">&lbrace;&rbrace; articles</a>
			  </h1>
			</div>
			<!-- Info 链接 -->
			<h1 class="nav-item info">
			  <a href="/info">⌘ info</a>
			</h1>
		  </header>
		<main>
			<slot />
		</main>		
	</body>
</html>

